@model ECommerceMVC.Models.ProductFormViewModel

@{
    ViewData["Title"] = $"Edit {Model.Name}";
}

<div class="max-w-2xl">
    <h1 class="font-serif text-2xl font-bold text-brand-950 mb-6">Edit Book</h1>

    <form asp-action="Edit" method="post" enctype="multipart/form-data" hx-boost="false" class="bg-white rounded-2xl border border-brand-100 p-7 space-y-5">
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>
        <input type="hidden" asp-for="ProductId" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
                <label asp-for="Name" class="block text-sm font-semibold text-gray-700 mb-1"></label>
                <input asp-for="Name" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-brand-700 focus:ring-1 focus:ring-brand-700 focus:outline-none" />
                <span asp-validation-for="Name" class="text-xs text-red-600"></span>
            </div>
            <div>
                <label asp-for="Author" class="block text-sm font-semibold text-gray-700 mb-1"></label>
                <input asp-for="Author" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-brand-700 focus:ring-1 focus:ring-brand-700 focus:outline-none" />
                <span asp-validation-for="Author" class="text-xs text-red-600"></span>
            </div>
        </div>

        <div>
            <label asp-for="Description" class="block text-sm font-semibold text-gray-700 mb-1"></label>
            <textarea asp-for="Description" rows="3" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-brand-700 focus:ring-1 focus:ring-brand-700 focus:outline-none"></textarea>
            <span asp-validation-for="Description" class="text-xs text-red-600"></span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
        {
            <div>
                <span class="block text-sm font-semibold text-gray-700 mb-1">Current Cover</span>
                <img src="@Model.CoverImageUrl" alt="Current cover" class="h-24 w-16 object-cover rounded-lg border border-gray-200" />
            </div>
        }

        <div>
            <label asp-for="CoverImageFile" class="block text-sm font-semibold text-gray-700 mb-1">Replace Cover Image</label>
            <input asp-for="CoverImageFile" type="file" accept="image/*" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm file:mr-3 file:rounded-md file:border-0 file:bg-brand-50 file:px-3 file:py-1.5 file:text-sm file:font-semibold file:text-brand-700 hover:file:bg-brand-100" />
            <span asp-validation-for="CoverImageFile" class="text-xs text-red-600"></span>
            <p class="text-xs text-ink/50 mt-1">Upload a file (JPG/PNG/GIF/WEBP, up to 5 MB) to replace it, or edit the link below instead.</p>
        </div>

        <div>
            <label asp-for="CoverImageUrl" class="block text-sm font-semibold text-gray-700 mb-1">...or Cover Image URL</label>
            <input asp-for="CoverImageUrl" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-brand-700 focus:ring-1 focus:ring-brand-700 focus:outline-none" />
            <span asp-validation-for="CoverImageUrl" class="text-xs text-red-600"></span>
        </div>

        <div class="grid grid-cols-2 gap-5">
            <div>
                <label asp-for="Price" class="block text-sm font-semibold text-gray-700 mb-1"></label>
                <input asp-for="Price" type="number" step="0.01" min="0" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-brand-700 focus:ring-1 focus:ring-brand-700 focus:outline-none" />
                <span asp-validation-for="Price" class="text-xs text-red-600"></span>
            </div>
            <div>
                <label asp-for="Stock" class="block text-sm font-semibold text-gray-700 mb-1"></label>
                <input asp-for="Stock" type="number" min="0" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-brand-700 focus:ring-1 focus:ring-brand-700 focus:outline-none" />
                <span asp-validation-for="Stock" class="text-xs text-red-600"></span>
            </div>
        </div>

        <div>
            <span class="block text-sm font-semibold text-gray-700 mb-2">Categories</span>
            @if (!Model.AllCategories.Any())
            {
                <p class="text-sm text-ink/60">No categories exist yet.</p>
            }
            else
            {
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                    @foreach (var category in Model.AllCategories)
                    {
                        <label class="flex items-center gap-2 text-sm text-gray-700 rounded-lg border border-gray-200 px-3 py-2 hover:bg-brand-50 cursor-pointer">
                            <input type="checkbox" name="SelectedCategoryIds" value="@category.CategoryId"
                                   checked="@Model.SelectedCategoryIds.Contains(category.CategoryId)"
                                   class="rounded border-gray-300 text-brand-700 focus:ring-brand-700" />
                            @category.Name
                        </label>
                    }
                </div>
            }
        </div>

        <div class="flex gap-3 pt-2">
            <button type="submit"
                    class="inline-flex items-center rounded-lg bg-gradient-to-br from-brand-700 to-brand-900 px-4 py-2 text-sm font-semibold text-white shadow transition hover:-translate-y-0.5 hover:shadow-lg">
                Save Changes
            </button>
            <a asp-action="Details" asp-route-id="@Model.ProductId" class="inline-flex items-center rounded-lg border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50">
                Cancel
            </a>
        </div>
    </form>
</div>
