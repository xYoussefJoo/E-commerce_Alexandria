@model ECommerceMVC.Models.Product

@{
    ViewData["Title"] = Model.Name;
}

<div class="grid grid-cols-1 md:grid-cols-[280px_1fr] gap-10">
    <div class="aspect-[2/3] rounded-xl overflow-hidden bg-brand-50 shadow-md">
        @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
        {
            <img src="@Model.CoverImageUrl" alt="Cover of @Model.Name" class="h-full w-full object-cover" />
        }
    </div>

    <div>
        <nav aria-label="breadcrumb" class="mb-3">
            <a asp-action="Index" class="text-sm text-brand-700 hover:text-brand-900">&larr; Back to Books</a>
        </nav>

        <h1 class="font-serif text-3xl font-bold text-brand-950 mb-1">@Model.Name</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Author))
        {
            <p class="text-ink/60 mb-4">by @Model.Author</p>
        }

        <p class="font-serif text-2xl font-bold text-brand-700 mb-4">@Model.Price.ToString("C")</p>

        <p class="text-sm mb-1">
            <span class="font-semibold text-brand-950">Stock:</span>
            <span class="text-ink/70">@Model.Stock available</span>
        </p>

        @if (Model.ViewCount > 0)
        {
            <p class="text-xs text-ink/50 mb-1">&#128065; @Model.ViewCount.ToString("N0") people have viewed this book</p>
        }

        @if (Model.Categories.Any())
        {
            <div class="flex flex-wrap gap-2 my-4">
                @foreach (var category in Model.Categories.OrderBy(c => c.Name))
                {
                    <a asp-controller="Category" asp-action="Details" asp-route-id="@category.CategoryId"
                       class="inline-block rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700 hover:bg-brand-100">
                        @category.Name
                    </a>
                }
            </div>
        }

        <p class="text-ink/80 leading-relaxed mt-4 max-w-xl">
            @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
        </p>

        @if (!User.IsInRole("Admin"))
        {
            @if (Model.Stock > 0)
            {
                <form asp-controller="Cart" asp-action="Add" method="post" hx-boost="false" class="add-to-cart-form flex items-center gap-3 mt-8">
                    <input type="hidden" name="productId" value="@Model.ProductId" />
                    <input type="number" name="quantity" value="1" min="1" max="@Model.Stock"
                           class="w-20 rounded-lg border border-gray-300 px-3 py-2 text-sm text-center" />
                    <button type="submit"
                            class="inline-flex items-center rounded-lg bg-gradient-to-br from-brand-700 to-brand-900 px-5 py-2.5 text-sm font-semibold text-white shadow transition hover:-translate-y-0.5 hover:shadow-lg">
                        Add to Cart
                    </button>
                </form>
            }
            else
            {
                <p class="mt-8 text-sm font-semibold text-red-600">Out of stock</p>
            }
        }

        @if (User.IsInRole("Admin"))
        {
            <div class="flex gap-3 mt-4">
                <a asp-action="Edit" asp-route-id="@Model.ProductId" hx-boost="false"
                   class="rounded-lg border border-brand-200 bg-white px-4 py-2 text-sm font-semibold text-brand-900 hover:bg-brand-50">Edit</a>
                <a asp-action="Delete" asp-route-id="@Model.ProductId" hx-boost="false"
                   class="rounded-lg border border-red-200 bg-white px-4 py-2 text-sm font-semibold text-red-600 hover:bg-red-50">Delete</a>
            </div>
        }
    </div>
</div>

@{
    var relatedProducts = ViewBag.RelatedProducts as List<ECommerceMVC.Models.Product>;
}
@if (relatedProducts != null && relatedProducts.Any())
{
    <section class="mt-16">
        <h2 class="font-serif text-2xl font-bold text-brand-950 mb-6">You Might Also Like</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6">
            @foreach (var related in relatedProducts)
            {
                <partial name="_ProductCard" model="related" />
            }
        </div>
    </section>
}
