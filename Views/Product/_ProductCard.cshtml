@model ECommerceMVC.Models.Product

<div class="group">
    <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.ProductId" class="block">
        <div class="aspect-[2/3] rounded-lg overflow-hidden bg-brand-50 shadow-sm transition group-hover:shadow-lg group-hover:-translate-y-1">
            @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
            {
                <img src="@Model.CoverImageUrl" alt="Cover of @Model.Name" class="h-full w-full object-cover" loading="lazy" />
            }
        </div>
        <h3 class="mt-3 text-sm font-semibold text-brand-950 leading-snug">@Model.Name</h3>
        @if (!string.IsNullOrWhiteSpace(Model.Author))
        {
            <p class="text-xs text-ink/60">@Model.Author</p>
        }
        <p class="mt-1 text-sm font-bold text-brand-700">@Model.Price.ToString("C")</p>
        <p class="text-xs text-ink/40">@Model.Stock in stock</p>
    </a>
    @if (Model.Stock > 0 && !User.IsInRole("Admin"))
    {
        <form asp-controller="Cart" asp-action="Add" method="post" hx-boost="false" class="add-to-cart-form mt-2">
            <input type="hidden" name="productId" value="@Model.ProductId" />
            <button type="submit" class="w-full rounded-lg border border-brand-200 bg-white px-2 py-1 text-xs font-semibold text-brand-700 hover:bg-brand-50">Add to Cart</button>
        </form>
    }
</div>
