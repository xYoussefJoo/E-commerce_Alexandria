@model ECommerceMVC.Models.Category

@{
    ViewData["Title"] = $"Delete {Model.Name}";
    var hasSubCategories = Model.SubCategories.Count > 0;
}

<div class="max-w-xl">
    <h1 class="font-serif text-2xl font-bold text-brand-950 mb-2">Delete Category</h1>
    <p class="text-gray-500 mb-6">This action cannot be undone.</p>

    <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 mb-4"></div>

    @if (hasSubCategories)
    {
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800 mb-6">
            <strong>Cannot delete this category yet.</strong>
            It still has @Model.SubCategories.Count subcategor@(Model.SubCategories.Count == 1 ? "y" : "ies") —
            reassign or delete them first.
        </div>
    }

    <div class="bg-white rounded-2xl border border-gray-100 p-7 space-y-4">
        <div>
            <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Name</div>
            <div class="text-base text-gray-900">@Model.Name</div>
        </div>
        <div>
            <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Description</div>
            <div class="text-base text-gray-900">@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</div>
        </div>
        <div>
            <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Products linked</div>
            <div class="text-base text-gray-900">@Model.Products.Count</div>
        </div>

        <form asp-action="Delete" asp-route-id="@Model.CategoryId" method="post" hx-boost="false" class="flex gap-3 pt-2">
            <button type="submit" disabled="@hasSubCategories"
                    class="inline-flex items-center rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow transition hover:bg-red-700 disabled:cursor-not-allowed disabled:bg-gray-300">
                Yes, delete this category
            </button>
            <a asp-action="Details" asp-route-id="@Model.CategoryId" class="inline-flex items-center rounded-lg border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50">
                Cancel
            </a>
        </form>
    </div>
</div>
