@model ECommerceMVC.Models.Category

@{
    ViewData["Title"] = $"Edit {Model.Name}";
    var parentOptions = new SelectList(ViewBag.ParentCategories as IEnumerable<Category>, "CategoryId", "Name", Model.ParentCategoryId);
}

<div class="max-w-xl">
    <h1 class="font-serif text-2xl font-bold text-brand-950 mb-6">Edit Category</h1>

    <form asp-action="Edit" method="post" hx-boost="false" class="bg-white rounded-2xl border border-gray-100 p-7 space-y-5">
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>
        <input type="hidden" asp-for="CategoryId" />

        <div>
            <label asp-for="Name" class="block text-sm font-semibold text-gray-700 mb-1"></label>
            <input asp-for="Name" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-brand-700 focus:ring-1 focus:ring-brand-700 focus:outline-none" />
            <span asp-validation-for="Name" class="text-xs text-red-600"></span>
        </div>

        <div>
            <label asp-for="Description" class="block text-sm font-semibold text-gray-700 mb-1"></label>
            <textarea asp-for="Description" rows="3" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-brand-700 focus:ring-1 focus:ring-brand-700 focus:outline-none"></textarea>
            <span asp-validation-for="Description" class="text-xs text-red-600"></span>
        </div>

        <div>
            <label asp-for="ImageUrl" class="block text-sm font-semibold text-gray-700 mb-1">Image URL</label>
            <input asp-for="ImageUrl" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-brand-700 focus:ring-1 focus:ring-brand-700 focus:outline-none" placeholder="https://..." />
            <span asp-validation-for="ImageUrl" class="text-xs text-red-600"></span>
        </div>

        <div>
            <label asp-for="ParentCategoryId" class="block text-sm font-semibold text-gray-700 mb-1">Parent Category</label>
            <select asp-for="ParentCategoryId" asp-items="parentOptions"
                    class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-brand-700 focus:ring-1 focus:ring-brand-700 focus:outline-none">
                <option value="">-- Top-level category --</option>
            </select>
            <span asp-validation-for="ParentCategoryId" class="text-xs text-red-600"></span>
        </div>

        <div class="flex gap-3 pt-2">
            <button type="submit"
                    class="inline-flex items-center rounded-lg bg-gradient-to-br from-brand-700 to-brand-900 px-4 py-2 text-sm font-semibold text-white shadow transition hover:-translate-y-0.5 hover:shadow-lg">
                Save Changes
            </button>
            <a asp-action="Details" asp-route-id="@Model.CategoryId" class="inline-flex items-center rounded-lg border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50">
                Cancel
            </a>
        </div>
    </form>
</div>
