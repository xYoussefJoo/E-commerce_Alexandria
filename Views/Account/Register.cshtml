@model ECommerceMVC.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register - Alexandria</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Source+Sans+3:wght@400;600;700&display=swap">
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-gradient-to-br from-brand-950 via-brand-900 to-brand-700 font-sans flex items-center justify-center px-4">
    <div class="w-full max-w-sm">
        <div class="flex flex-col items-center mb-8">
            <svg viewBox="0 0 24 24" fill="none" class="h-10 w-10 text-gold-400 mb-2">
                <path d="M2 5c3-1.5 6.5-1.5 9 0v14c-2.5-1.5-6-1.5-9 0V5Z" fill="currentColor"/>
                <path d="M22 5c-3-1.5-6.5-1.5-9 0v14c2.5-1.5 6-1.5 9 0V5Z" fill="currentColor"/>
            </svg>
            <span class="font-serif text-2xl font-bold text-white">Alexandria</span>
            <span class="text-xs text-gold-400 tracking-widest uppercase mt-1">Create Account</span>
        </div>

        <form asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="bg-white rounded-2xl p-7 space-y-5 shadow-2xl">
            <div asp-validation-summary="All" class="text-sm text-red-600"></div>

            <div>
                <label asp-for="Email" class="block text-sm font-semibold text-gray-700 mb-1"></label>
                <input asp-for="Email" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-brand-700 focus:ring-1 focus:ring-brand-700 focus:outline-none" placeholder="you@example.com" autofocus />
                <span asp-validation-for="Email" class="text-xs text-red-600"></span>
            </div>

            <div>
                <label asp-for="Password" class="block text-sm font-semibold text-gray-700 mb-1"></label>
                <input asp-for="Password" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-brand-700 focus:ring-1 focus:ring-brand-700 focus:outline-none" />
                <span asp-validation-for="Password" class="text-xs text-red-600"></span>
                <p class="text-xs text-gray-400 mt-1">At least 8 characters, with upper/lowercase, a digit and a symbol.</p>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="block text-sm font-semibold text-gray-700 mb-1"></label>
                <input asp-for="ConfirmPassword" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-brand-700 focus:ring-1 focus:ring-brand-700 focus:outline-none" />
                <span asp-validation-for="ConfirmPassword" class="text-xs text-red-600"></span>
            </div>

            <button type="submit"
                    class="w-full inline-flex items-center justify-center rounded-lg bg-gradient-to-br from-brand-700 to-brand-900 px-4 py-2.5 text-sm font-semibold text-white shadow transition hover:-translate-y-0.5 hover:shadow-lg">
                Create Account
            </button>
        </form>

        <p class="text-center text-sm text-brand-200 mt-6">
            Already have an account? <a asp-controller="Account" asp-action="Login" class="font-semibold text-gold-400 hover:text-white">Sign In</a>
        </p>
        <p class="text-center text-xs text-brand-200 mt-3">
            <a asp-controller="Home" asp-action="Index" class="hover:text-white">&larr; Back to store</a>
        </p>
    </div>
</body>
</html>
