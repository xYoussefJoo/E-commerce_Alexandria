@model ECommerceMVC.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    string StatusColor(OrderStatus s) => OrderStatusStyles.TextClass(s);
}

<div class="flex flex-wrap items-center justify-between gap-4 mb-8">
    <div>
        <h1 class="font-serif text-3xl font-bold text-brand-950">Admin Dashboard</h1>
        <p class="text-ink/60 mt-1">Sales, customers, and catalog — all in one place.</p>
    </div>
    <div class="flex gap-3">
        <a asp-controller="Orders" asp-action="Index" class="rounded-lg border border-brand-200 bg-white px-4 py-2 text-sm font-semibold text-brand-900 hover:bg-brand-50">Manage Orders</a>
        <a asp-controller="Product" asp-action="Index" class="rounded-lg border border-brand-200 bg-white px-4 py-2 text-sm font-semibold text-brand-900 hover:bg-brand-50">Manage Books</a>
        <a asp-controller="Category" asp-action="Index" class="rounded-lg border border-brand-200 bg-white px-4 py-2 text-sm font-semibold text-brand-900 hover:bg-brand-50">Manage Categories</a>
    </div>
</div>

<!-- KPI tiles -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
    <div class="rounded-2xl border border-brand-100 bg-white p-6">
        <p class="text-xs font-semibold text-ink/50 uppercase tracking-wide">Total Revenue</p>
        <p class="font-serif text-4xl font-bold text-brand-950 mt-2">@Model.TotalRevenue.ToString("C")</p>
        <p class="text-xs text-ink/50 mt-1">Avg order @Model.AverageOrderValue.ToString("C")</p>
    </div>
    <div class="rounded-2xl border border-brand-100 bg-white p-6">
        <p class="text-xs font-semibold text-ink/50 uppercase tracking-wide">Total Orders</p>
        <p class="font-serif text-4xl font-bold text-brand-950 mt-2">@Model.TotalOrders</p>
    </div>
    <div class="rounded-2xl border border-brand-100 bg-white p-6">
        <p class="text-xs font-semibold text-ink/50 uppercase tracking-wide">Customers</p>
        <p class="font-serif text-4xl font-bold text-brand-950 mt-2">@Model.TotalCustomers</p>
    </div>
    <div class="rounded-2xl border border-brand-100 bg-white p-6">
        <p class="text-xs font-semibold text-ink/50 uppercase tracking-wide">Total Books</p>
        <p class="font-serif text-4xl font-bold text-brand-950 mt-2">@Model.TotalBooks</p>
    </div>
</div>

<!-- Revenue trend -->
<div class="rounded-2xl border border-brand-100 bg-white p-7 mb-6">
    <h2 class="font-serif text-lg font-bold text-brand-950 mb-4">Revenue — Last 14 Days</h2>
    @if (Model.TotalRevenue <= 0)
    {
        <p class="text-sm text-ink/60">No paid or pending orders yet — revenue will chart here once sales start coming in.</p>
    }
    else
    {
        <div class="h-64">
            <canvas id="revenueChart"></canvas>
        </div>
    }
</div>

<!-- Status / payment breakdowns -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <div class="rounded-2xl border border-brand-100 bg-white p-7">
        <h2 class="font-serif text-lg font-bold text-brand-950 mb-4">Orders by Status</h2>
        @if (!Model.OrdersByStatus.Any())
        {
            <p class="text-sm text-ink/60">No orders yet.</p>
        }
        else
        {
            <ul class="space-y-3">
                @foreach (var (status, count) in Model.OrdersByStatus)
                {
                    <li class="flex items-center justify-between">
                        <span class="text-sm font-semibold @StatusColor(status)">@status</span>
                        <span class="text-sm font-bold text-brand-950">@count</span>
                    </li>
                }
            </ul>
        }
    </div>
    <div class="rounded-2xl border border-brand-100 bg-white p-7">
        <h2 class="font-serif text-lg font-bold text-brand-950 mb-4">Orders by Payment Method</h2>
        @if (!Model.OrdersByPaymentMethod.Any())
        {
            <p class="text-sm text-ink/60">No orders yet.</p>
        }
        else
        {
            <ul class="space-y-3">
                @foreach (var (method, count) in Model.OrdersByPaymentMethod)
                {
                    <li class="flex items-center justify-between">
                        <span class="text-sm font-semibold text-brand-900">@method</span>
                        <span class="text-sm font-bold text-brand-950">@count</span>
                    </li>
                }
            </ul>
        }
    </div>
</div>

<!-- Top customers / best sellers -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <div class="rounded-2xl border border-brand-100 bg-white p-7">
        <h2 class="font-serif text-lg font-bold text-brand-950 mb-4">Top Customers</h2>
        @if (!Model.TopCustomers.Any())
        {
            <p class="text-sm text-ink/60">No customers have placed an order yet.</p>
        }
        else
        {
            <ul class="space-y-3">
                @foreach (var (email, orderCount, totalSpent) in Model.TopCustomers)
                {
                    <li class="flex items-center justify-between gap-3">
                        <div class="min-w-0">
                            <p class="text-sm font-semibold text-brand-950 truncate">@email</p>
                            <p class="text-xs text-ink/50">@orderCount order@(orderCount == 1 ? "" : "s")</p>
                        </div>
                        <span class="shrink-0 text-sm font-bold text-brand-700">@totalSpent.ToString("C")</span>
                    </li>
                }
            </ul>
        }
    </div>
    <div class="rounded-2xl border border-brand-100 bg-white p-7">
        <h2 class="font-serif text-lg font-bold text-brand-950 mb-4">Best Sellers (by units sold)</h2>
        @if (!Model.BestSellingBooks.Any())
        {
            <p class="text-sm text-ink/60">No books have sold yet.</p>
        }
        else
        {
            <ul class="space-y-3">
                @foreach (var (productName, quantitySold) in Model.BestSellingBooks)
                {
                    <li class="flex items-center justify-between gap-3">
                        <span class="text-sm font-semibold text-brand-950 truncate">@productName</span>
                        <span class="shrink-0 inline-block rounded-full bg-gold-100 px-3 py-1 text-xs font-semibold text-gold-600">@quantitySold sold</span>
                    </li>
                }
            </ul>
        }
    </div>
</div>

<!-- Recent orders -->
<div class="rounded-2xl border border-brand-100 bg-white p-7 mb-6">
    <h2 class="font-serif text-lg font-bold text-brand-950 mb-4">Recent Orders</h2>
    @if (!Model.RecentOrders.Any())
    {
        <p class="text-sm text-ink/60">No orders yet.</p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-left text-ink/50 border-b border-brand-50">
                        <th class="py-2 font-semibold">Order</th>
                        <th class="py-2 font-semibold">Customer</th>
                        <th class="py-2 font-semibold">Date</th>
                        <th class="py-2 font-semibold">Status</th>
                        <th class="py-2 font-semibold text-right">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (orderId, email, orderDate, status, totalAmount) in Model.RecentOrders)
                    {
                        <tr class="border-b border-brand-50">
                            <td class="py-2.5 font-medium text-brand-950">#@orderId</td>
                            <td class="py-2.5 text-ink/70 truncate max-w-[200px]">@email</td>
                            <td class="py-2.5 text-ink/70">@orderDate.ToString("MMM d, yyyy")</td>
                            <td class="py-2.5 font-semibold @StatusColor(status)">@status</td>
                            <td class="py-2.5 text-right font-bold text-brand-950">@totalAmount.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <!-- Most viewed -->
    <div class="rounded-2xl border border-brand-100 bg-white p-7">
        <h2 class="font-serif text-lg font-bold text-brand-950 mb-4">Most Viewed Books</h2>
        @if (!Model.MostViewedBooks.Any(b => b.ViewCount > 0))
        {
            <p class="text-sm text-ink/60">No book views recorded yet — they'll appear here as customers browse Details pages.</p>
        }
        else
        {
            <ul class="space-y-3">
                @foreach (var book in Model.MostViewedBooks)
                {
                    <li class="flex items-center justify-between gap-3">
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@book.ProductId" class="text-sm font-semibold text-brand-950 hover:text-brand-700 truncate">@book.Name</a>
                        <span class="shrink-0 inline-block rounded-full bg-gold-100 px-3 py-1 text-xs font-semibold text-gold-600">@book.ViewCount views</span>
                    </li>
                }
            </ul>
        }
    </div>

    <!-- Recently added -->
    <div class="rounded-2xl border border-brand-100 bg-white p-7">
        <h2 class="font-serif text-lg font-bold text-brand-950 mb-4">Recently Added</h2>
        <ul class="space-y-3">
            @foreach (var book in Model.RecentlyAddedBooks)
            {
                <li class="flex items-center justify-between gap-3">
                    <a asp-controller="Product" asp-action="Details" asp-route-id="@book.ProductId" class="text-sm font-semibold text-brand-950 hover:text-brand-700 truncate">@book.Name</a>
                    <span class="shrink-0 text-xs text-ink/50">@book.CreatedAt.ToString("MMM d, yyyy")</span>
                </li>
            }
        </ul>
    </div>
</div>

<!-- Low stock -->
<div class="rounded-2xl border border-brand-100 bg-white p-7">
    <h2 class="font-serif text-lg font-bold text-brand-950 mb-4">Low Stock (below 10)</h2>
    @if (!Model.LowStockBooks.Any())
    {
        <p class="text-sm text-ink/60">Nothing is running low right now.</p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-left text-ink/50 border-b border-brand-50">
                        <th class="py-2 font-semibold">Book</th>
                        <th class="py-2 font-semibold">Stock</th>
                        <th class="py-2 font-semibold"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var book in Model.LowStockBooks)
                    {
                        <tr class="border-b border-brand-50">
                            <td class="py-2.5 font-medium text-brand-950">@book.Name</td>
                            <td class="py-2.5">
                                <span class="inline-block rounded-full bg-red-50 px-3 py-1 text-xs font-semibold text-red-600">@book.Stock left</span>
                            </td>
                            <td class="py-2.5 text-right">
                                <a asp-controller="Product" asp-action="Edit" asp-route-id="@book.ProductId" class="text-brand-700 hover:text-brand-900 font-semibold">Restock &rarr;</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (Model.TotalRevenue > 0)
{
    @* Loaded inline (not @section Scripts) so it's inside #main-content and still runs
       after an htmx-boosted navigation, since only #main-content is swapped in. *@
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
    <script>
        (function () {
            var labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueByDay.Select(d => d.Date.ToString("MMM d"))));
            var data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueByDay.Select(d => d.Revenue)));
            var canvas = document.getElementById('revenueChart');
            if (!canvas || !window.Chart) return;

            new Chart(canvas, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Revenue',
                        data: data,
                        borderColor: '#8f2d39',
                        backgroundColor: 'rgba(143, 45, 57, 0.08)',
                        borderWidth: 2,
                        pointRadius: 4,
                        pointBackgroundColor: '#8f2d39',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 1,
                        fill: true,
                        tension: 0.25
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function (ctx) { return '$' + ctx.parsed.y.toFixed(2); }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: '#f6e6e8' },
                            ticks: { callback: function (v) { return '$' + v; } }
                        },
                        x: {
                            grid: { display: false }
                        }
                    }
                }
            });
        })();
    </script>
}
